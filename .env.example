# --- Core ---
ENV=dev
DATABASE_URL=postgresql+asyncpg://voice:voice@localhost:5443/voice
REDIS_URL=redis://localhost:6390/0
INTERNAL_API_TOKEN=
WORKSPACE_COOKIE_SECRET=
APP_ORIGIN=http://localhost:5173

# --- LiveKit Cloud ---
LIVEKIT_URL="wss://YOUR-PROJECT.livekit.cloud"
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=voice-agent
ENABLE_NOISE_CANCELLATION=true   # LiveKit Cloud only; set false when self-hosting

# --- Gemini (LLM, context-prompt generation, summaries). Read by livekit-plugins-google as GOOGLE_API_KEY ---
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash
AGENT_LLM_MODEL=gemini-3.5-flash-lite

# --- Deepgram (STT + TTS). Env var read by livekit-plugins-deepgram ---
DEEPGRAM_API_KEY=
STT_PROVIDER=deepgram
TTS_PROVIDER=deepgram
STT_MODEL=nova-3
TTS_MODEL=aura-2-andromeda-en

# --- Agent -> backend ---
BACKEND_INTERNAL_URL=http://backend:8000
LATENCY_PROFILE=balanced

# --- SIP outbound (Phase 4) ---
SIP_OUTBOUND_TRUNK_ID=
SIP_TRUNK_ADDRESS=
SIP_TRUNK_NUMBERS=
SIP_AUTH_USERNAME=
SIP_AUTH_PASSWORD=

# --- Feature flags / retention ---
FEATURE_OUTBOUND_PANEL=false
TRANSCRIPT_RETENTION_DAYS=90
SUMMARY_WEBHOOK_URL=
SUMMARY_WEBHOOK_SECRET=
